# API
PORT=4000
NODE_ENV=development

# Admin
ADMIN_PIN=change-me

# Optional PostgreSQL persistence.
# If omitted, development falls back to server/data/store.json.
DATABASE_URL=
DB_SSL=false

# Comma-separated frontend origins allowed by CORS.
# Example: https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=

# Optional persistent directory for uploaded images.
# Example on a host with a mounted volume: /data/uploads
UPLOAD_DIR=
