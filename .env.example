# API
PORT=4000
NODE_ENV=development

# Admin authentication. Required in every environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Use a long random secret (minimum 32 characters).
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_SESSION_HOURS=8

# PostgreSQL persistence.
# If omitted, development falls back to server/data/store.json.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=5

# Comma-separated browser origins allowed by CORS.
# Leave empty when frontend and API are served by this same Node app.
# Example: https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=

# Recommended production image storage: Cloudinary.
# When all three credentials are present, uploads are stored permanently there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kenza

# Local/development fallback for uploaded images.
# On a host with a persistent disk this can point to that mounted volume.
UPLOAD_DIR=
